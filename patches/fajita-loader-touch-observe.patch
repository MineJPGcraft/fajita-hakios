+static const char *
+touch_phase_name(uint32_t phase)
+{
+	switch (phase) {
+	case FT_PHASE_DISABLED: return "disabled/not-entered";
+	case FT_PHASE_INIT: return "init";
+	case FT_PHASE_DEFERRED_ARMED: return "deferred-armed";
+	case FT_PHASE_CREATE_THREAD: return "create-thread";
+	case FT_PHASE_THREAD_ENTERED: return "thread-entered";
+	case FT_PHASE_BEFORE_MAPPING: return "before-mapping";
+	case FT_PHASE_MAP_GPIO: return "map-gpio";
+	case FT_PHASE_SNAPSHOT_GPIO: return "snapshot-gpio";
+	case FT_PHASE_PINMUX: return "pinmux";
+	case FT_PHASE_TLMM_READ: return "TLMM-read";
+	case FT_PHASE_TLMM_WRITE: return "TLMM-write";
+	case FT_PHASE_PAGE_ZERO: return "page-zero";
+	case FT_PHASE_PDT: return "PDT";
+	case FT_PHASE_CONFIGURE_SCAN: return "configure-scan";
+	case FT_PHASE_SCANNING: return "scanning";
+	case FT_PHASE_STOPPED: return "stopped";
+	case FT_PHASE_SKIPPED: return "skipped";
+	default: return "unknown";
+	}
+}
