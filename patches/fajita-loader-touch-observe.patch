+static void
+note_touch_progress(const struct kernel_live *live, uint64_t slide, uint64_t seconds)
+{
+	uint64_t pa, state;
+	const volatile struct fajita_touch_live *touch;
+	if (live == NULL) { return; }
+	if (!live_range_contains((uint64_t)(uintptr_t)live, sizeof(*live))) {
+		print("FT: independent state not available\n"); return;
+	}
+	flush_dcache((uint64_t)(uintptr_t)&live->magic3, (uint64_t)(uintptr_t)&live->touch_live + 8);
+	if (live->magic3 != FAJITA_LIVE_MAGIC3 || live->size != sizeof(*live) || live->touch_live == 0) {
+		print("FT: independent state not available\n"); return;
+	}
+	pa = live->touch_live + slide;
+	if ((pa & 63) || !live_range_contains(pa, sizeof(*touch))) { print("FT: invalid state pointer\n"); return; }
+	flush_dcache(pa, pa + sizeof(*touch));
+	touch = (const volatile struct fajita_touch_live *)(uintptr_t)pa;
+	if (touch->magic != FAJITA_TOUCH_LIVE_MAGIC || touch->size != sizeof(*touch)) {
+		print("FT: independent state ABI mismatch\n"); return;
+	}
+	state = touch->state;  /* one naturally aligned 64-bit snapshot */
+	print("FT=%d data=%x %s (%d s)\n", state >> 32, state & 0xffffffffULL,
+	    touch_phase_name((uint32_t)(state >> 32)), seconds);
 }
 
