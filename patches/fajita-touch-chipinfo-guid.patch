+guid_initializer = "{ " + ", ".join(hex(value) for value in guid_words[:3]) + ", { " + \
+    ", ".join(hex(value) for value in guid_words[3:]) + " } }"
+print(f"ChipInfo GUID evidence: staged .dec = built FV Guid.xref = SDM845 ChipInfo.efi: {actual_guid}")
