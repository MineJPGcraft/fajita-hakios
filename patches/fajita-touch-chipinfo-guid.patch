+# must not serve as both the implementation's input and the mock's oracle.
+declaration = re.search(
+    r"^\s*gEfiChipInfoProtocolGuid\s*=\s*(\{[^\n]+\})\s*$",
+    (QCOM / "QcomPkg.dec").read_text(), re.MULTILINE)
