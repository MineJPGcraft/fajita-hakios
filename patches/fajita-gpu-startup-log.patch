+/*
+ * Say whether the service this file started is actually published, and whether
+ * it can be opened. Called once, after RedwoodGPUStart(), by the phone's GPU
+ * driver: a service that failed to register and a window server that chose not
+ * to draw both look like a black screen, and telling them apart from the kernel
+ * side is the difference between looking at IOKit and looking at userland.
+ */
+extern "C" void
+RedwoodGPURegistryReport(void)
+{
+	char line[160];
+	unsigned n = 0;
+
+	if (!gpuRegistered) {
+		loader_log_line("fajitagpu: service: NOT registered (RedwoodGPUStart did not get that far)\n");
+		return;
+	}
+	{
+		/*
+		 * By NAME, not by class. serviceMatching() keys on IOProviderClass --
+		 * "the services whose provider is of this class" -- so asking it for
+		 * "RedwoodGPU" looks for children of a RedwoodGPU and can never find
+		 * RedwoodGPU itself. That is why this reported 0 while the service was
+		 * published all along: userland asks with IOServiceMatching(name),
+		 * which is nameMatching() here.
+		 */
+		OSDictionary * matching = IOService::nameMatching("RedwoodGPU");
+
+		if (matching != NULL) {
+			OSIterator * matched = IOService::getMatchingServices(matching);
+
+			if (matched != NULL) {
+				OSObject * o;
+
+				while ((o = matched->getNextObject()) != NULL) {
+					n++;
+				}
+				matched->release();
+			}
+			matching->release();
+		}
+	}
+	snprintf(line, sizeof(line), "fajitagpu: service: registered, %u in the registry, lock %s\n",
+	    n, gGPULock != NULL ? "allocated" : "MISSING");
+	loader_log_line(line);
+}
