diff --git a/hakios-metal/Makefile b/hakios-metal/Makefile
index f8a1f35..1bb4bf8 100644
--- a/hakios-metal/Makefile
+++ b/hakios-metal/Makefile
@@ -34,7 +34,7 @@ HAKIOS    ?= $(if $(wildcard ../xnu/apply.sh),..,../workspace)
 -include tools/kernels.mk
 -include tools/compiler.mk
 ifneq ($(strip $(MESA)),)
-override CXXFLAGS += -DHAKIOS_METAL_MESA $(HAKIOS_METAL_MESA_CXXFLAGS)
+override CXXFLAGS += $(CHIP_DEFINES) -DHAKIOS_METAL_MESA $(HAKIOS_METAL_MESA_CXXFLAGS)
 HOSTLIBS  += $(HAKIOS_METAL_MESA_LIBS)
 HOSTOUT   = out/host-mesa$(if $(SAN),-$(SAN))
 endif
@@ -91,8 +91,15 @@ ios: out/ios/libhakios-metal.a $(if $(wildcard $(IR3_CMDLINE_C)),out/ios/hakios-
 
 darwin: ios
 
+# CHIP=a630 builds for the Adreno 630 (0x06030001) instead of the Adreno 7c+ Gen 3 (0x06030500). The two differ in
+# has_lpac, instr_cache_size and fibers_per_sp (freedreno_devices.py: a6xx_gen1 against a6xx_gen4), and those size the
+# streams the emitters write, so a build is for one part and refuses the other by name rather than driving it with the
+# wrong numbers. Unset: the A635-family part this tree grew up on.
+CHIP ?=
+CHIP_DEFINES := $(if $(filter a630,$(CHIP)),-DHAKIOS_METAL_CHIP_A630)
+
 # with MESA=1 the compiler goes to the phone too, against the iOS build of Mesa's libraries (IOS_MESA_BUILD, tools/compiler.mk)
-IOS_CXXFLAGS = -std=c++17 -O2 -Wall -Wextra -Werror
+IOS_CXXFLAGS = -std=c++17 -O2 -Wall -Wextra -Werror $(CHIP_DEFINES)
 IOS_LIBS     =
 ifneq ($(strip $(MESA)),)
 IOS_CXXFLAGS += -DHAKIOS_METAL_MESA $(HAKIOS_METAL_IOS_MESA_CXXFLAGS)
