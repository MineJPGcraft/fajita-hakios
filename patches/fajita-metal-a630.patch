@@ -1185,12 +1185,19 @@ TEST(a_kernel_longer_than_the_instruction_cache_gets_the_instrlen_workaround) {
         CHECK(cb->status() == CommandBuffer::kCompleted);
     }
     {
+        // chain160's own instrlen is 96 units (fixtures/chain160_air.hpp), not its name. Whether that
