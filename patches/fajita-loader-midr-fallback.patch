--- a/xnuloader/loader.c
+++ b/xnuloader/loader.c
@@ -4329,0 +4330,14 @@ efi_main(efi_handle image, efi_system_table *st)
+	/*
+	 * GOP is optional on this port and its framebuffer base can differ between
+	 * XBL/UEFI revisions.  Do the SoC fallback outside the GOP branch as well;
+	 * otherwise a fajita loader failure is reported as a qemu-virt reset and
+	 * the useful held-on-screen log is lost.
+	 */
+	if (PLAT == &platform_qemu_virt) {
+		uint64_t midr = READ_SYSREG(MIDR_EL1);
+		for (unsigned i = 0; i < sizeof(platforms) / sizeof(platforms[0]); i++)
+			for (int j = 0; j < 2; j++)
+				if (platforms[i]->midr_part[j] && (midr >> 24 & 0xFF) == 0x51 &&
+				    (midr >> 4 & 0xFFF) == platforms[i]->midr_part[j])
+					PLAT = platforms[i];
+	}
